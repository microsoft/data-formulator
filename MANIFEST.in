include py-src/data_formulator/dist/*
include py-src/data_formulator/dist/assets/*
recursive-include py-src/data_formulator/data_loader/guides *.md
include py-src/data_formulator/analyst/skills/map/countries.json
include py-src/data_formulator/example_datasets/*.csv
recursive-include py-src/data_formulator/spaces *.md *.yaml *.py *.csv *.png *.svg *.json *.parquet *.jsx
global-exclude .DS_Store
exclude py-src/examples