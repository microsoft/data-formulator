{
  "cases": [
    {
      "name": "thread with a branch and a legacy derived table",
      "input": {
        "tables": [
          {
            "id": "s1",
            "createdAt": 0
          },
          {
            "id": "d1",
            "parentNodeId": "t1",
            "createdAt": 2,
            "derive": {
              "trigger": {
                "tableId": "s1"
              }
            }
          },
          {
            "id": "d2",
            "createdAt": 5,
            "derive": {
              "trigger": {
                "tableId": "d1"
              }
            }
          }
        ],
        "turns": [
          {
            "id": "t1",
            "parentNodeId": "s1",
            "createdAt": 1
          },
          {
            "id": "t2",
            "parentNodeId": "d1",
            "createdAt": 3
          },
          {
            "id": "t3",
            "parentNodeId": "d1",
            "createdAt": 4
          }
        ]
      },
      "queries": [
        "t2",
        "t3",
        "d2"
      ],
      "expected": {
        "threads": [
          {
            "key": "thread-s1",
            "rootId": "s1",
            "branchFromId": null,
            "nodeIds": [
              "s1",
              "t1",
              "d1",
              "t2"
            ]
          },
          {
            "key": "thread-t3",
            "rootId": "s1",
            "branchFromId": "d1",
            "nodeIds": [
              "t3"
            ]
          },
          {
            "key": "thread-d2",
            "rootId": "s1",
            "branchFromId": "d1",
            "nodeIds": [
              "d2"
            ]
          }
        ],
        "queries": {
          "t2": {
            "ancestors": [
              "d1",
              "t1",
              "s1"
            ],
            "tableOf": "d1",
            "nearestItem": "d1"
          },
          "t3": {
            "ancestors": [
              "d1",
              "t1",
              "s1"
            ],
            "tableOf": "d1",
            "nearestItem": "d1"
          },
          "d2": {
            "ancestors": [
              "d1",
              "t1",
              "s1"
            ],
            "tableOf": "d2",
            "nearestItem": "d2"
          }
        }
      }
    },
    {
