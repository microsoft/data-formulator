          },
          "f1": {
            "ancestors": [
              "set1",
              "w1",
              "a1",
              "conversation-root:a"
            ],
            "tableOf": "s1",
            "nearestItem": "f1"
          },
          "r1": {
            "ancestors": [
              "a2",
              "conversation-root:a"
            ],
            "tableOf": null,
            "nearestItem": "r1"
          },
          "draft1": {
            "ancestors": [
              "after",
              "set1",
              "w1",
              "a1",
              "conversation-root:a"
            ],
            "tableOf": "s1",
            "nearestItem": "set1"
          }
        }
      }
    },
    {
      "name": "a parent cycle and a deleted parent",
      "input": {
        "turns": [
          {
            "id": "x",
            "parentNodeId": "y",
            "createdAt": 2
          },
          {
            "id": "y",
            "parentNodeId": "x",
            "createdAt": 1
          },
          {
            "id": "z",
            "parentNodeId": "x",
            "createdAt": 3
          },
          {
            "id": "orphan",
            "parentNodeId": "gone",
            "createdAt": 0
          }
        ]
      },
      "queries": [
        "z",
        "orphan"
      ],
      "expected": {
        "threads": [
          {
            "key": "thread-orphan",
            "rootId": "gone",
            "branchFromId": null,
            "nodeIds": [
              "orphan"
            ]
          },
          {
            "key": "thread-y",
            "rootId": "conversation-root:y",
            "branchFromId": null,
            "nodeIds": [
              "y",
              "x",
              "z"
            ]
          }
        ],
        "queries": {
          "z": {
            "ancestors": [
              "x",
              "y",
              "conversation-root:y"
            ],
            "tableOf": null,
            "nearestItem": null
          },
          "orphan": {
            "ancestors": [
              "gone"
            ],
            "tableOf": null,
            "nearestItem": null
          }
        }
      }
    }
  ]
