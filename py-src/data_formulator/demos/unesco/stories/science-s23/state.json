     "code": "import pandas as pd\nr=pd.read_parquet('data/rd_sdg_national.parquet'); s=r[r.COUNTRY_ID.isin(['CHN','USA'])]\nprint(s.groupby(['country','indicator_id']).agg(first=('year','min'),last=('year','max'),n=('value','count')).to_string())\nprint(s[s.year.isin([2000,2023,2024])][['country','indicator_id','year','value','qualifier']].to_string(index=False))",
