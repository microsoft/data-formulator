     "purpose": "Check recent public heritage spending, coverage, and country differences.",
     "code": "import pandas as pd\nx=pd.read_parquet('data/sdg11_national.parquet')\nx=x[(x.indicator_id=='HEXPCSTPPPCAP.HER.PU') & (x.year>=2020) & x.value.notna() & (x.magnitude.fillna('')!='NA')].sort_values('year').drop_duplicates('COUNTRY_ID',keep='last')\nprint(len(x),x.year.value_counts().sort_index().to_dict())\nprint(x.sort_values('value',ascending=False)[['country','year','value']].to_string(index=False))\nprint('median',x.value.median(),'under1',sum(x.value<1),'estimates',x.qualifier.notna().sum())",
