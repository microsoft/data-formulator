   "derive": {
    "code": "import pandas as pd\nimport duckdb\nout=duckdb.query(\"SELECT COUNTRY_ID, country, year, value, qualifier FROM read_parquet('data/sdg4_national.parquet') WHERE indicator_id='SCHBSP.1.WELEC' AND year BETWEEN 2020 AND 2025 AND value BETWEEN 0 AND 100 AND (magnitude IS NULL OR magnitude NOT IN ('NA','SUPP')) QUALIFY row_number() OVER (PARTITION BY COUNTRY_ID ORDER BY year DESC)=1\").df()\nout=out.merge(pd.read_parquet('data/countries.parquet')[['COUNTRY_ID','map_id']],on='COUNTRY_ID',how='left')\nout['without_power']=100-out['value']\nout['country']=out.country.replace({'Democratic Republic of the Congo':'DR Congo','United Republic of Tanzania':'Tanzania','United Kingdom of Great Britain and Northern Ireland':'UK'})\nout=out.sort_values('without_power',ascending=False)",
