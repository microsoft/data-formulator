   "derive": {
    "code": "import duckdb\nout=duckdb.sql(\"\"\"WITH completion AS (SELECT * FROM read_parquet('data/sdg4_national.parquet') WHERE indicator_id='CR.MOD.3' AND year BETWEEN 2020 AND 2025 AND value IS NOT NULL AND coalesce(magnitude,'') NOT IN ('NA','SUPP','INCLUDED') QUALIFY row_number() OVER(PARTITION BY COUNTRY_ID ORDER BY year DESC)=1), pop AS (SELECT COUNTRY_ID,value AS population_thousands FROM read_parquet('data/dem_national.parquet') WHERE indicator_id='200101' AND year BETWEEN 2020 AND 2025 QUALIFY row_number() OVER(PARTITION BY COUNTRY_ID ORDER BY year DESC)=1) SELECT a.country,a.year,a.value,a.qualifier,c.map_id,p.population_thousands FROM completion a JOIN read_parquet('data/countries.parquet') c USING(COUNTRY_ID) JOIN pop p USING(COUNTRY_ID) WHERE p.population_thousands>=100 AND c.map_id IS NOT NULL ORDER BY a.value\"\"\").df()\nout['country']=out.country.replace({'Democratic Republic of the Congo':'DR Congo','United Republic of Tanzania':'Tanzania','United Kingdom of Great Britain and Northern Ireland':'UK'})\nout['value']=out.value.round(1)",
