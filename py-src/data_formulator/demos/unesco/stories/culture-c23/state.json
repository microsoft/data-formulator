   "derive": {
    "code": "import pandas as pd\nx=pd.read_parquet('data/sdg11_national.parquet'); x=x[x.indicator_id.eq('HEXPCSTPPPCAP.HER.PU')]\na=x[x.year.between(2017,2019)].sort_values('year').groupby('COUNTRY_ID').tail(1)\nb=x[x.year.between(2022,2024)].sort_values('year').groupby('COUNTRY_ID').tail(1)\nx=a.merge(b,on='COUNTRY_ID',suffixes=('_before','_after'))\nx['increase']=x.value_after-x.value_before\nout=x[x.increase>0].nlargest(15,'increase').copy()\nout['country']=out.country_after\nprint(out[['country','increase','year_before','year_after']].to_string(index=False))",
