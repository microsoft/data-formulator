    "code": "import duckdb, pandas as pd\nn=duckdb.sql(\"SELECT COUNTRY_ID, country, year, value, qualifier FROM read_parquet('data/opri_national.parquet') WHERE indicator_id='OFST.1T3.CP' AND year BETWEEN 2020 AND 2025 AND value IS NOT NULL AND value>=0 QUALIFY row_number() OVER (PARTITION BY COUNTRY_ID ORDER BY year DESC)=1\").df()\nc=pd.read_parquet('data/countries.parquet')\noutput=n.merge(c[['COUNTRY_ID','map_id']],on='COUNTRY_ID').dropna(subset=['map_id'])\noutput['millions']=output.value/1000000\noutput['country']=output.country.replace({'Democratic Republic of the Congo':'DR Congo','United Republic of Tanzania':'Tanzania','United Kingdom of Great Britain and Northern Ireland':'UK'})",
