     "code": "import duckdb\nq=\"\"\"SELECT COUNTRY_ID,country,year,value,qualifier FROM read_parquet('data/opri_national.parquet') WHERE indicator_id='26637' AND year BETWEEN 2021 AND 2023 AND value IS NOT NULL AND (magnitude IS NULL OR magnitude<>'NA') QUALIFY row_number() OVER(PARTITION BY COUNTRY_ID ORDER BY year DESC)=1 ORDER BY value DESC\"\"\"\nd=duckdb.sql(q).df()\nprint(d.head(15).to_string(index=False));print('countries',len(d));print(d.year.value_counts().to_string())",
