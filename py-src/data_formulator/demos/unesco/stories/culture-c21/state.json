     "purpose": "Compare national and local heritage spending in each country's latest matched year since 2020.",
     "code": "import pandas as pd\nx=pd.read_parquet('data/sdg11_national.parquet')\nids={'HEXPCSTPPPCAPGOV.LOC.HER.PU':'Local','HEXPCSTPPPCAPGOV.NTL.HER.PU':'National'}\na=x[x.indicator_id.isin(ids)&x.year.ge(2020)].copy();a['level']=a.indicator_id.map(ids)\np=a.pivot(index=['COUNTRY_ID','country','year'],columns='level',values='value').dropna().reset_index().sort_values('year').drop_duplicates('COUNTRY_ID',keep='last')\np=p[~p.COUNTRY_ID.isin(['AND','SMR','MCO','LIE'])]\np['local_share']=100*p.Local/(p.Local+p.National)\nprint(p.to_string(index=False));print('COUNTS',len(p),(p.National>p.Local).sum(),(p.Local>p.National).sum());print(a.qualifier.value_counts())",
