   "derive": {
    "code": "import duckdb\n\nout = duckdb.sql(\"\"\"\n    with pairs as (\n        select a.COUNTRY_ID as country_id, a.country, a.year, a.value as national, b.value as local\n        from read_parquet('data/sdg11_national.parquet') a\n        join read_parquet('data/sdg11_national.parquet') b using (COUNTRY_ID, year)\n        where a.indicator_id = 'HEXPCSTPPPCAPGOV.NTL.HER.PU' and b.indicator_id = 'HEXPCSTPPPCAPGOV.LOC.HER.PU'\n          and a.year between 2020 and 2024\n          and a.value is not null and b.value is not null\n          and coalesce(a.magnitude, '') not in ('NA', 'SUPP', 'INCLUDED')\n          and coalesce(b.magnitude, '') not in ('NA', 'SUPP', 'INCLUDED')\n        qualify row_number() over (partition by a.COUNTRY_ID order by a.year desc) = 1\n    ),\n    population as (\n        select COUNTRY_ID as country_id, value as thousands\n        from read_parquet('data/dem_national.parquet')\n        where indicator_id = '200101'\n        qualify row_number() over (partition by COUNTRY_ID order by year desc) = 1\n    )\n    select p.country_id, p.country, p.year as latest_year, round(p.national, 1) as national,\n           round(p.local, 1) as local, round(100 * p.local / (p.local + p.national), 1) as local_share\n    from pairs p join population using (country_id)\n    where population.thousands >= 100\n    order by local_share desc, p.country\n\"\"\").df()\nout['country'] = out.country.replace({'Bolivia (Plurinational State of)': 'Bolivia', 'China, Hong Kong Special Administrative Region': 'Hong Kong', 'China, Macao Special Administrative Region': 'Macao', \"Democratic People's Republic of Korea\": 'North Korea', 'Democratic Republic of the Congo': 'DR Congo', 'Iran (Islamic Republic of)': 'Iran', \"Lao People's Democratic Republic\": 'Laos', 'Micronesia (Federated States of)': 'Micronesia', 'Republic of Korea': 'South Korea', 'Republic of Moldova': 'Moldova', 'Russian Federation': 'Russia', 'Syrian Arab Republic': 'Syria', 'United Kingdom of Great Britain and Northern Ireland': 'UK', 'United Republic of Tanzania': 'Tanzania', 'United States of America': 'US', 'Venezuela (Bolivarian Republic of)': 'Venezuela', 'Viet Nam': 'Vietnam'})\n",
    "outputVariable": "out",
    "source": [
     "dem_national",
     "sdg11_national"
    ],
