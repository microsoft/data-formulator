    "code": "import pandas as pd\nx=pd.read_parquet('data/sdg11_national.parquet')\np=x[x.indicator_id.isin(['HEXPCSTPPPCAP.CULHER','HEXPCSTPPPCAP.NATHER'])].pivot(index=['COUNTRY_ID','country','year'],columns='indicator_id',values='value').dropna().reset_index()\np=p[(p.year>=2020)&(p.COUNTRY_ID!='AND')].sort_values('year').drop_duplicates('COUNTRY_ID',keep='last')\np=p.rename(columns={'HEXPCSTPPPCAP.CULHER':'cultural','HEXPCSTPPPCAP.NATHER':'natural'})\np['share']=100*p.natural/(p.natural+p.cultural)\nout=p.merge(pd.read_parquet('data/countries.parquet')[['COUNTRY_ID','map_id']],on='COUNTRY_ID');out['map_id']=out.map_id.astype(int)",
