{
  "version": 1,
  "title": "Monuments or nature: where heritage money goes",
  "subtitle": "Natural heritage's share of spending on cultural and natural heritage, public and private; latest year with both, 2020–2024; more on nature above 50%",
  "source": "UIS, February 2026 release; indicators HEXPCSTPPPCAP.CULHER, HEXPCSTPPPCAP.NATHER",
  "template": "choropleth",
  "data": {
    "table": "heritage_spending_nature_share"
  },
  "encoding": {
