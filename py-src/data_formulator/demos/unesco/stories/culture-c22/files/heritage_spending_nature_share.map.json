    },
    "latest_year": {
      "semanticType": "Year",
      "displayName": "Latest year with data"
    },
    "cultural": {
      "semanticType": "Price",
      "unit": "PPP$ per person",
      "displayName": "Spending on cultural heritage per person"
    },
    "natural": {
      "semanticType": "Price",
      "unit": "PPP$ per person",
      "displayName": "Spending on natural heritage per person"
    },
    "nature_share": {
      "semanticType": "Percentage",
      "unit": "%",
      "displayName": "Nature's share of heritage spending",
      "divergingMidpoint": 50
    }
  },
  "view": {
    "style": "light"
  }
