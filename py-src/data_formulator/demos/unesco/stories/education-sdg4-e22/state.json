   "derive": {
    "code": "import duckdb\nresult=duckdb.sql(\"WITH latest AS (SELECT COUNTRY_ID, country, year, value, qualifier FROM read_parquet('data/sdg4_national.parquet') WHERE indicator_id='READ.PRIMARY' AND year BETWEEN 2018 AND 2023 AND value IS NOT NULL AND (magnitude IS NULL OR magnitude <> 'NA') QUALIFY row_number() OVER(PARTITION BY COUNTRY_ID ORDER BY year DESC)=1) SELECT l.*, c.map_id FROM latest l JOIN read_parquet('data/countries.parquet') c USING(COUNTRY_ID) WHERE c.map_id IS NOT NULL\").df()\nresult['country']=result['country'].replace({'Russian Federation':'Russia','United Kingdom of Great Britain and Northern Ireland':'UK','United States of America':'United States','China, Hong Kong Special Administrative Region':'Hong Kong','China, Macao Special Administrative Region':'Macao','Iran (Islamic Republic of)':'Iran','Democratic Republic of the Congo':'DR Congo','United Republic of Tanzania':'Tanzania'})",
