     "id": "code_exploreDataFromNL_1792308394272_1",
     "tool": "execute_python_script",
     "purpose": "Identify countries with high reading proficiency using their latest assessments from 2018–2023.",
     "code": "import duckdb\nn=duckdb.sql(\"SELECT country, COUNTRY_ID, year, value FROM read_parquet('data/sdg4_national.parquet') WHERE indicator_id='READ.PRIMARY' AND year BETWEEN 2018 AND 2023 AND value IS NOT NULL AND (magnitude IS NULL OR magnitude <> 'NA') QUALIFY row_number() OVER(PARTITION BY COUNTRY_ID ORDER BY year DESC)=1 ORDER BY value DESC\").df()\nprint('Countries:',len(n),'Above 50%:',sum(n.value>50));print(n.head(20).to_string(index=False))",
     "status": "completed",
     "createdAt": 1792308414759,
