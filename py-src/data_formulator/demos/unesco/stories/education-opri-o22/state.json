    "code": "import duckdb\n\nout = duckdb.sql(\"\"\"\n    with v as (\n        select region, year, indicator_id, value\n        from read_parquet('data/opri_regional.parquet')\n        where indicator_id in ('ILLPOP.AG15T99', 'ILLPOP.AG15T99.F')\n          and region in ('SDG: Sub-Saharan Africa', 'SDG: Northern Africa and Western Asia', 'SDG: Central and Southern Asia', 'SDG: Eastern and South-Eastern Asia', 'SDG: Latin America and the Caribbean', 'SDG: Oceania', 'SDG: Europe and Northern America')\n    )\n    select replace(t.region, 'SDG: ', '') as region, t.year, round(t.value / 1e6, 1) as millions,\n           round(100 * f.value / t.value, 1) as women_share\n    from v t left join v f on f.region = t.region and f.year = t.year\n      and f.indicator_id = 'ILLPOP.AG15T99.F'\n    where t.indicator_id = 'ILLPOP.AG15T99'\n      and t.year = (select max(year) from v where indicator_id = 'ILLPOP.AG15T99')\n    order by millions desc\n\"\"\").df()\n",
